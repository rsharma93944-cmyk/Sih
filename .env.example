# ==========================================================
# ResQAI Frontend Environment Configuration Template
# ==========================================================
# Copy this file to .env and replace YOUR_API_KEY_HERE with your actual map API key.
# Compatible with Vanilla JS, Vite, React (CRA), Next.js, and Netlify deployments.

# Live Map API Key (MapTiler / Mapbox / Carto / Stadia / Custom Map Provider)
MAP_API_KEY=YOUR_API_KEY_HERE

# For Vite-based builds or environments
VITE_MAP_API_KEY=YOUR_API_KEY_HERE

# For Create React App builds or environments
REACT_APP_MAP_API_KEY=YOUR_API_KEY_HERE
